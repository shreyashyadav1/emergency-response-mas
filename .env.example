# Copy this file to .env and fill in a key. .env is ignored by git.
# OpenAI: a key from https://platform.openai.com/api-keys (the account needs prepaid credit, $5 minimum).
OPENAI_API_KEY=
# Or Gemini, free: a key from https://aistudio.google.com (Get API key), with LLM_MODEL=gemini-3.5-flash-lite.
GEMINI_API_KEY=

# Optional. The model picks the server: gemini-* models go to Gemini, the rest to OpenAI.
LLM_MODEL=gpt-4o-mini
# Optional. Model requests per minute; keep it under your account's limit (8 for Gemini's free tier).
LLM_RPM=8
